      "repeat": 4176
    },
    {
      "key": "street",
      "seconds": 16,
      "set": "street",
      "costume": "day, shoes, backpack",
      "line": "s13",
      "leadSecond": 2.4,
      "target": true,
      "purpose": "보호자가 윤수를 보며 손을 내민다. 손을 잡고 걷다가 안내판 근처에 멈추고 다시 출발한다.",
      "startState": "보호자 왼쪽에 윤수, 경장 동행.",
      "endState": "윤수·보호자 손잡은 상태, 선생님과 입구 방향.",
      "i": 13,
      "start": 4632,
      "end": 5016,
      "turn": [
        4815,
