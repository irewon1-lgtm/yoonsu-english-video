  "scenes": [
    {
      "key": "alarm",
      "seconds": 12,
      "set": "bedroom",
      "costume": "pajamas",
      "line": "s01",
      "leadSecond": 6.4,
      "purpose": "윤수가 알람 쪽으로 몸을 돌리고 손을 내민다. 의자 아래 청록색 가방과 겨자색 별 장식을 먼저 보여준다.",
      "startState": "윤수 침대 위, 이불, 오른손 비어 있음. 경장이 방문에서 안을 본다.",
      "endState": "알람 꺼짐, 이불 열기 직전. 가방은 같은 의자 아래.",
      "i": 1,
      "start": 0,
      "end": 288,
      "turn": null,
      "lead": 154,
      "cue": null,
      "repeat": null
    },
    {
      "key": "wake",
      "seconds": 17,
      "set": "bedroom",
      "costume": "pajamas",
      "line": "s02",
      "leadSecond": 8.8,
      "target": true,
      "purpose": "이불을 접고 팔로 몸을 받친 다음 다리를 내린다. 두 발을 디디고 일어나 경장의 기지개에 미소로 응답한다.",
      "startState": "침대 위, 맨발, 경장 방문.",
      "endState": "침대 옆 두 발 접지, 복도 쪽. 가방은 의자 아래.",
      "i": 2,
      "start": 288,
      "end": 696,
      "turn": [
        602,
        674,
        "Good morning!"
      ],
      "lead": 499,
      "cue": 532,
      "repeat": 572
    },
    {
      "key": "wash",
      "seconds": 16,
      "set": "bath",
      "costume": "pajamas",
      "line": "s03",
      "leadSecond": 1.7,
      "target": true,
      "purpose": "수도, 손바닥에 물 받기, 얼굴 세수, 수건, 수도 끄기 순.",
      "startState": "세면대 앞, 수건 걸이, 수도 닫힘.",
      "endState": "수도 닫힘, 수건 제자리. 양손 비어 있음.",
      "i": 3,
      "start": 696,
      "end": 1080,
      "turn": [
        856,
        928,
        "I wash my face."
      ],
      "lead": 737,
      "cue": 778,
      "repeat": 818
    },
    {
      "key": "breakfast",
      "seconds": 16,
      "set": "kitchen",
      "costume": "pajamas",
      "line": "s04",
      "leadSecond": 1.45,
      "target": true,
      "purpose": "빈 숟가락을 보기 전에 배고픔을 말하고, 의자를 빼서 앉아 숟가락으로 먹은 뒤 내려놓는다.",
      "startState": "식탁·의자·오트밀·숟가락, 경장 옆.",
      "endState": "숟가락은 그릇 옆, 표정 만족. 식탁에서 일어선다.",
      "i": 4,
      "start": 1080,
      "end": 1464,
      "turn": [
        1218,
        1290,
        "I'm hungry."
      ],
      "lead": 1115,
      "cue": 1148,
      "repeat": 1188
    },
    {
      "key": "brush",
      "seconds": 16,
      "set": "bath",
      "costume": "pajamas",
      "line": "s05",
      "leadSecond": 1.4,
      "target": true,
      "purpose": "대사가 끝난 후 칫솔을 들어 앞니를 짧게 닦고 컵으로 헹군 뒤 내려놓는다.",
      "startState": "칫솔과 컵은 세면대 선반.",
      "endState": "칫솔과 컵은 같은 선반. 양손 비어 있음.",
      "i": 5,
      "start": 1464,
      "end": 1848,
      "turn": [
        1619,
        1691,
        "I brush my teeth."
      ],
      "lead": 1498,
      "cue": 1540,
      "repeat": 1580
    },
    {
      "key": "dress",
      "seconds": 17,
      "set": "bedroom",
      "costume": "pajamas to day top",
      "line": "s06",
      "leadSecond": 2.0,
      "target": true,
      "purpose": "크림 칼라의 녹색·남색 럭비 셔츠를 보여준 뒤 머리를 통과시키고 소매 양쪽에 팔을 차례로 넣는다. 밑단을 손으로 펴고, 하의를 갈아입는 시간은 다음 연결 숏에서 생략한다.",
      "startState": "두 손에 침대 위 셔츠, 별 잠옷.",
      "endState": "착용한 승인 상의, 하의 교체는 다음 숏 전.",
      "i": 6,
      "start": 1848,
      "end": 2256,
      "turn": [
        2007,
        2079,
        "My green shirt!"
      ],
      "lead": 1896,
      "cue": 1933,
      "repeat": 1973
    },
    {
      "key": "socks",
      "seconds": 17,
      "set": "bedroom",
      "costume": "day, bare to socks",
      "line": "s07",
      "leadSecond": 1.5,
      "target": true,
      "purpose": "경장이 뒤틀린 양말의 뒤꿈치를 가리키면 윤수가 손가락으로 입구를 잡고 뒤꿈치를 맞춘다.",
      "startState": "청바지, 맨발, 의자에 흰 양말.",
      "endState": "양쪽 흰 양말, 신발 미착용.",
      "i": 7,
      "start": 2256,
      "end": 2664,
      "turn": [
        2397,
        2469,
        "My socks!"
      ],
      "lead": 2292,
      "cue": 2326,
      "repeat": 2366
    },
    {
      "key": "mirror",
      "seconds": 8,
      "set": "bedroom",
      "costume": "day, socks",
      "line": "s08",
      "leadSecond": 4.6,
      "purpose": "경장이 빈 어깨를 보고 끈을 메는 동작을 한다. 윤수의 눈이 먼저 움직이고 고개가 돌아간다.",
      "startState": "등원복·양말, 양손 비어 있음.",
      "endState": "윤수가 의자를 향한다.",
      "i": 8,
      "start": 2664,
      "end": 2856,
      "turn": null,
      "lead": 2774,
      "cue": null,
      "repeat": null
    },
    {
      "key": "search",
      "seconds": 16,
      "set": "bedroom",
      "costume": "day, socks",
      "line": "s09",
      "leadSecond": 3.45,
      "target": true,
      "purpose": "두 걸음을 옮겨 책상 주변을 보고 팔꿈치를 허벅지에 대며 숙인다. 경장이 발밑을 살핀다.",
      "startState": "문에서 의자 쪽, 가방은 의자 아래.",
      "endState": "두 인물 모두 의자 밑의 별 장식을 본다.",
      "i": 9,
      "start": 2856,
      "end": 3240,
      "turn": [
        3048,
        3120,
        "Where's my bag?"
      ],
      "lead": 2939,
      "cue": 2975,
      "repeat": 3015
    },
    {
      "key": "find",
      "seconds": 17,
      "set": "bedroom",
      "costume": "day, socks",
      "line": "s10",
      "leadSecond": 3.5,
      "target": true,
      "purpose": "아침에 보였던 별 이름표를 발견한다. 손잡이 잡기, 바닥에서 가방 들기, 이동까지 이어진다.",
      "startState": "의자 아래 같은 청록색 별 가방.",
      "endState": "윤수 왼손에 가방, 현관 방향.",
      "i": 10,
      "start": 3240,
      "end": 3648,
      "turn": [
        3423,
        3495,
        "Here it is!"
      ],
      "lead": 3324,
      "cue": 3355,
      "repeat": 3395
    },
    {
      "key": "shoes",
      "seconds": 18,
      "set": "entry",
      "costume": "day, socks to shoes",
      "line": "s11",
      "leadSecond": 2.29,
      "target": true,
      "purpose": "가방을 벤치 옆에 내려놓고 앉는다. 손으로 신발을 벌려 신은 다음 벨크로를 닫고 발을 딛는다.",
      "startState": "가방을 벤치 옆에 내려놓기 직전. 한쪽 신발은 신은 상태, 반대쪽 발은 양말.",
      "endState": "두 신발, 가방은 그대로 벤치 옆.",
      "i": 11,
      "start": 3648,
      "end": 4080,
      "turn": [
        3802,
        3874,
        "Shoes on!"
      ],
      "lead": 3703,
      "cue": 3734,
      "repeat": 3774
    },
    {
      "key": "depart",
      "seconds": 23,
      "set": "entry",
      "costume": "day, shoes, backpack",
      "line": "s12",
      "leadSecond": 1.02,
      "target": true,
      "purpose": "가방을 들어 한쪽과 반대쪽 팔을 끈에 넣는다. 경장이 문손잡이로 문을 열고 윤수와 보호자가 문턱을 넘는다. 경장도 뒤따라간다.",
      "startState": "신발 끈 정리, 가방은 벤치 옆.",
      "endState": "가방 양 끈 착용, 윤수와 보호자 문밖, 경장 문밖.",
      "i": 12,
      "start": 4080,
      "end": 4632,
      "turn": [
        4205,
        4277,
        "Let's go!"
      ],
      "lead": 4104,
